#!/bin/bash
# Launch all TRustBrowser instances

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "Launching all TRustBrowser instances..."

# Launch each instance in the background
"$SCRIPT_DIR/rbrowser-whatsapp" &
sleep 0.5  # Small delay to stagger startup

"$SCRIPT_DIR/rbrowser-calendar" &
sleep 0.5

"$SCRIPT_DIR/rbrowser-messenger" &

echo "All instances launched!"
